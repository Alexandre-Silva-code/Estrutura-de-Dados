//Implemente a função soma_precos, que devolve a soma do campo preco de todos os produtos armazenados na lista. Se li for NULL, a função deve devolver 0.

#include <stdio.h>

#define MAX 100

struct lista{
    int qtd;
    float dados[MAX];
    float preco;
};

typedef struct lista Lista;

float soma_precos(Lista* li){
    if(li == NULL){
        return 0;
    }
    li->preco = 0;
    for(int i = 0; i < li->qtd; i++){
        li->preco = li->preco + li->dados[i];
    }
    return li->preco;
}


//teste
int main(){
    Lista* lista_nula = NULL;
    printf("Teste nulo = R$%.2f", soma_precos(lista_nula));

    Lista minha_lista;
    minha_lista.qtd = 3;

    minha_lista.dados[0]= 10.5;
    minha_lista.dados[1]= 7.5;
    minha_lista.dados[2]= 12.0;

    float total = soma_precos(&minha_lista);
    printf("O total é R$%.2f", total);
    return 0;
}
