#include <stdio.h>
#include <string.h>

#define MAX 100

struct produto{
    int codigo;
    char nome[50];
    float preco;
};

struct lista{
    int qtd;
    struct produto dados[MAX];
};

typedef struct lista Lista;

int busca_por_nome(Lista* li, char *nome, struct produto *p){
    if(li == NULL || nome == NULL || p == NULL){
        return 0;
    }

    for(int i = 0; i < li->qtd; i++){
        if(strcmp(li->dados[i].nome, nome) == 0){
            *p = li->dados[i];
            return 1;
        }
    }
    return 0;

}
